DATABASE_URL=postgresql+psycopg://chess_user:chess_password@localhost:5433/chess_insights

# Engine analysis. Stockfish is installed manually - see the README.
# Leave STOCKFISH_PATH unset to run without engine analysis; the ordinary test
# suite does not need it. Only the *worker* uses the engine; the API never
# starts one, so a missing binary means jobs stay queued rather than failing.
# STOCKFISH_PATH=C:\tools\stockfish\stockfish-windows-x86-64-avx2.exe
STOCKFISH_DEPTH=12
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64

# --- Analysis worker -------------------------------------------------------
# Read only by `python -m app.worker`. None of these affect the API.

# How many games are analysed at once. This is a hard ceiling on concurrent
# Stockfish processes, however many games are queued. Approximate CPU demand is
# ANALYSIS_WORKER_CONCURRENCY x STOCKFISH_THREADS, and memory roughly
# ANALYSIS_WORKER_CONCURRENCY x STOCKFISH_HASH_MB.
ANALYSIS_WORKER_CONCURRENCY=1

# How long a claim stays valid without a heartbeat. A worker that dies leaves
# its lease to expire, and the next worker to start recovers the job.
ANALYSIS_LEASE_SECONDS=60

# How often the lease is renewed while a game is being analysed. Also bounds
# how quickly a running job notices that it has been cancelled.
ANALYSIS_HEARTBEAT_SECONDS=2.0

# How long to wait before checking the queue again when it is empty.
ANALYSIS_POLL_SECONDS=2.0

# How often to look for jobs abandoned by a dead worker.
ANALYSIS_STALE_SWEEP_SECONDS=30.0

# Delay before a retried job becomes claimable, so a job that reliably kills
# its worker cannot spin in a tight claim-crash-claim loop.
ANALYSIS_RETRY_DELAY_SECONDS=5
